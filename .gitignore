# Local scrape state: the SQLite DB holds cached page bodies and is rebuilt
# from the sources, so it is never committed. CI persists it via actions/cache.
data/

# Generated outputs. `public/` is assembled by the workflow from site/ plus
# the scraper's output and published to Pages, so it is never committed.
public/
*.ics
*.json
!.github/**/*.json
# ...except the published calendar, which IS tracked so its history shows how
# listings changed over time. Written by the daily workflow.
!calendar/paris-events.ics
!calendar/paris.json

# Secrets. The ScrapingAnt key lives here for local runs; CI uses a
# repository secret. Never commit either.
.scrapingant_key
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
